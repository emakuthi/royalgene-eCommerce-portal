# Example environment variables for local development (DO NOT COMMIT SECRETS)
# Supabase - public (client) and service role (server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# SUPABASE_SERVICE_ROLE_KEY should be set in your host provider (Vercel) and never committed
SUPABASE_SERVICE_ROLE_KEY=

# Database
DATABASE_URL=

# JWT settings
JWT_SECRET=
JWT_EXPIRY=7d

# Node
NODE_ENV=development

# M-Pesa (sandbox credentials)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORT_CODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# App
APP_NAME=Royal-Gene-eCommerce
APP_URL=http://localhost:3000
APP_TIMEZONE=Africa/Nairobi

# Feature flags
ENABLE_TWO_FACTOR=false
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false

# Portal
PORTAL_NAME=Royal-Gene-Portal
PORTAL_URL=http://localhost:3000/portal

