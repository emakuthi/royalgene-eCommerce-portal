# Example environment variables for local development (DO NOT COMMIT SECRETS)
# Supabase - public (client) and service role (server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# SUPABASE_SERVICE_ROLE_KEY should be set in your host provider (Vercel) and never committed
SUPABASE_SERVICE_ROLE_KEY=

# Database
DATABASE_URL=

# JWT settings
JWT_SECRET=
JWT_EXPIRY=7d

# Node
NODE_ENV=development

# Multi-tenancy
# Root domain tenants are resolved under, e.g. acme.<this> -> tenant "acme".
# Production: royaltrack.royalgenegroup.co.ke (needs wildcard DNS
# *.royaltrack.royalgenegroup.co.ke -> Vercel for tenant subdomains).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3001
# Fallback tenant slug used when the Host header is the bare root domain
# (mainly for local dev, where *.localhost subdomains may be inconvenient)
DEV_TENANT_SLUG=royalgene

# Paystack (Phase 3 — platform subscription billing, unused until then)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# SMTP (transactional email — signup verification, workspace codes).
# Hostinger's SMTP host is smtp.hostinger.com, port 465 with SMTP_SECURE=true
# (SSL), or port 587 with SMTP_SECURE=false (STARTTLS). SMTP_USER/SMTP_PASS
# are the full mailbox address and its password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@royalgenegroup.co.ke

# Platform super_admin bootstrap (npm run admin:create)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Admin

# Vercel (tenant custom domains — Settings > Domain tab)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# Only needed if the Vercel project is under a team account, not personal
VERCEL_TEAM_ID=

# M-Pesa is configured per-tenant (Settings > Integrations), not via env vars —
# each tenant stores their own Daraja API credentials, encrypted at rest using
# the key below. Generate with `openssl rand -base64 32`. Required for the
# Integrations tab to work at all; treat it like any other production secret.
CREDENTIALS_ENCRYPTION_KEY=

# Google / Facebook sign-in (mobile + portal). Comma-separated
# GOOGLE_OAUTH_CLIENT_IDS is normally just the one Web client ID from Google
# Cloud Console — mobile's native GoogleSignIn requests an ID token audience'd
# to it, and it doubles as the client ID for the portal's server-side
# authorization-code exchange, which additionally needs the matching secret.
# Register <your-domain>/api/portal/auth/google/callback (the default
# tenant's host) as an authorized redirect URI for that client.
GOOGLE_OAUTH_CLIENT_IDS=
GOOGLE_OAUTH_CLIENT_SECRET=
# Facebook Developer app — register <your-domain>/api/portal/auth/facebook/callback
# (the default tenant's host) as a valid OAuth redirect URI.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# QuickBooks Online (one platform-level app; each tenant connects their own
# company via OAuth). Register an app at developer.intuit.com yourself first —
# this can't be done from code — then set the redirect URI there to
# <your-domain>/api/portal/integrations/quickbooks/callback.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# App
APP_NAME=Royal-Gene-eCommerce
APP_URL=http://localhost:3000
APP_TIMEZONE=Africa/Nairobi

# Feature flags
ENABLE_TWO_FACTOR=false
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false

# Portal
PORTAL_NAME=Royal-Gene-Portal
PORTAL_URL=http://localhost:3000/portal

